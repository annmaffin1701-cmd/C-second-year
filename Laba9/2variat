//преподователь дает задание студенту
//студент выполняет задание и ответ дает преподавателю
//препод дает оценку от 1 до 10. сделать как сущности, задание пример на сложение
//препод будет оценивать на сколько ответ не совпадает X+Y.
//если ответ не равен,на 2,то оценка 8.
//студенту задать на сколько о будет ошибаться в ответ 5.
#include <algorithm>
#include <iostream>
#include <cstdlib>

struct Zadanie
{
    int x;
    int y;
};

struct Student
{
    int otvet;
    int osibka;
};

struct Prepod
{
    Zadanie zadanie;
    int pravilniiOtvet;
    int ocenka;
};

void datiZadanie(Prepod* prepod, Zadanie zadanie)
{
    prepod->zadanie = zadanie;

    prepod->pravilniiOtvet =
        zadanie.x + zadanie.y;
}

int reshitZadanie(Zadanie zadanie)
{
    int otvet;

    std::cout << "Reshi primer: "
              << zadanie.x << " + " << zadanie.y << " = ";

    std::cin >> otvet;

    return otvet;
}

void postavitiOcencu(Prepod* prepod, Student* student)
{
    int raznicaOtveta = std::abs(
        prepod->pravilniiOtvet - student->otvet
    );

    prepod->ocenka = std::max(1, 10 - raznicaOtveta);
}

int main()
{
    Zadanie spisokZadanii[] =
    {
        {2, 3},
        {5, 5},
        {7, 4},
        {10, 8},
        {15, 6}
    };

    int kolichestvoZadanii =
        sizeof(spisokZadanii) / sizeof(spisokZadanii[0]);

    std::cout << "Spisok zadanii:\n";

    for (int i = 0; i < kolichestvoZadanii; i++)
    {
        std::cout
            << i + 1 << ". "
            << spisokZadanii[i].x
            << " + "
            << spisokZadanii[i].y
            << '\n';
    }

    int nomerZadaniya;

    std::cout << "\nPrepod vyberaet zadanie (1-"
              << kolichestvoZadanii << "): ";
    std::cin >> nomerZadaniya;

    if (nomerZadaniya < 1 ||
        nomerZadaniya > kolichestvoZadanii)
    {
        std::cout << "Neverniy nomer zadaniya!\n";
        return 1;
    }

    Prepod prepod{};

    Student student{};

    datiZadanie(
        &prepod,
        spisokZadanii[nomerZadaniya - 1]
    );

    std::cout << "\nPrepod dal zadanie: "
              << prepod.zadanie.x
              << " + "
              << prepod.zadanie.y
              << " = ?\n";

    std::cout << "Na skolko student oshibetsya v otvete: ";
    std::cin >> student.osibka;

   student.otvet = reshitZadanie(prepod.zadanie);

    postavitiOcencu(&prepod, &student);

    std::cout << "\n--- Rezultat ---\n";

    std::cout << "Primer: "
              << prepod.zadanie.x
              << " + "
              << prepod.zadanie.y
              << '\n';

    std::cout << "Pravilniy otvet: "
              << prepod.pravilniiOtvet
              << '\n';

    std::cout << "Otvet studenta: "
              << student.otvet
              << '\n';

    std::cout << "Raznica otvetov: "
              << std::abs(
                  prepod.pravilniiOtvet - student.otvet
              )
              << '\n';

    std::cout << "Ocenka: "
              << prepod.ocenka
              << '\n';

    return 0;
}